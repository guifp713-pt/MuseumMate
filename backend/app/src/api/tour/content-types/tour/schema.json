{
  "kind": "collectionType",
  "collectionName": "tours",
  "info": {
    "singularName": "tour",
    "pluralName": "tours",
    "displayName": "Tour"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "nameTour": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "timeTour": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "descriptionTour": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "imageTour": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::item.item"
    },
    "maps": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::map.map"
    },
    "entidade": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::entidade.entidade",
      "inversedBy": "tours"
    },
    "isMainTour": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    },
    "audioTour": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": false,
      "allowedTypes": [
        "audios"
      ]
    },
    "areas": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::area.area"
    }
  }
}
